<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quanlibancoffee.client.controller.SanPhamController">

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="QUẢN LÝ SẢN PHẨM" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6F4E37;" />
        <Region HBox.hgrow="ALWAYS" /> <TextField fx:id="txtSearch" promptText="Tìm kiếm tên món..." prefWidth="250" style="-fx-background-radius: 20; -fx-padding: 8;" />
        <ComboBox fx:id="cbCategoryFilter" promptText="Tất cả loại" prefWidth="150" style="-fx-background-radius: 5;" />
        <Button text="+ Thêm món mới" onAction="#handleAdd" style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
    </HBox>

    <TableView fx:id="tableProducts" VBox.vgrow="ALWAYS" style="-fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colImage" text="Hình ảnh" prefWidth="100" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colName" text="Tên món" prefWidth="200" style="-fx-alignment: CENTER-LEFT; -fx-font-weight: bold;" />
            <TableColumn fx:id="colCategory" text="Loại" prefWidth="120" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colPrice" text="Giá tiền" prefWidth="100" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colAction" text="Chức năng" prefWidth="150" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>