<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quanlibancoffee.client.controller.RegisterController"
            style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 12, 0, 0, 6);">

    <left>
        <StackPane prefWidth="430">
            <ImageView fitWidth="500" fitHeight="600" preserveRatio="false">
                <image>
                    <Image url="@/quanlibancoffee/client/image/coffee.jpg" />
                </image>
            </ImageView>
        </StackPane>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 45; -fx-background-color: #FAF6F0;">
            <children>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="TẠO TÀI KHOẢN" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #4E342E; -fx-letter-spacing: 1px;"/>
                    <Label text="Đăng ký thành viên để tham gia hệ thống" style="-fx-font-size: 13px; -fx-text-fill: #8D6E63;" />
                </VBox>

                <VBox maxWidth="320" spacing="12">
                    <children>
                        <VBox spacing="5">
                            <Label text="Tên đăng nhập" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5D4037;" />
                            <TextField fx:id="txtUsername" prefHeight="38" promptText="Nhập tên đăng nhập"
                                       style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E0D4C3; -fx-border-radius: 8; -fx-padding: 0 12 0 12;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Email" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5D4037;" />
                            <TextField fx:id="txtEmail" prefHeight="38" promptText="Nhập email"
                                       style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E0D4C3; -fx-border-radius: 8; -fx-padding: 0 12 0 12;" />
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Mật khẩu" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5D4037;" />
                            <PasswordField fx:id="txtPassword" prefHeight="38" promptText="Nhập mật khẩu"
                                           style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E0D4C3; -fx-border-radius: 8; -fx-padding: 0 12 0 12;" />
                        </VBox>
                    </children>
                </VBox>

                <Label fx:id="lblMessage" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>

                <VBox spacing="12" alignment="CENTER">
                    <children>
                        <Button text="ĐĂNG KÝ" prefWidth="320" prefHeight="45" onAction="#handleRegister"
                                style="-fx-background-color: #D35400; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(211,84,0,0.25), 8, 0, 0, 3);"/>

                        <Hyperlink text="Đã có tài khoản? Đăng nhập" onAction="#goLogin" style="-fx-text-fill: #5D4037; -fx-font-size: 13px; -fx-underline: false;"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>

</BorderPane>