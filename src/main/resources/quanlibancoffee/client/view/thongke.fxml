<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>


<ScrollPane fitToWidth="true" style="-fx-background-color: #FDF5E6;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quanlibancoffee.client.controller.ThongKeController">
    <content>
        <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: #FDF5E6;">

            <Label text="TỔNG QUAN KINH DOANH" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #6F4E37; -fx-font-family: 'Segoe UI';" />

            <HBox spacing="20" alignment="CENTER">
                <VBox style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d); -fx-background-radius: 15; -fx-padding: 20;" prefWidth="300">
                    <Label text="DOANH THU HÔM NAY" textFill="white" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblTodayRevenue" text="0 đ" textFill="white" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: linear-gradient(to right, #f2994a, #f2c94c); -fx-background-radius: 15; -fx-padding: 20;" prefWidth="300">
                    <Label text="ĐƠN HÀNG ĐÃ BÁN" textFill="white" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblTotalOrders" text="0" textFill="white" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: linear-gradient(to right, #eb3349, #f45c43); -fx-background-radius: 15; -fx-padding: 20;" prefWidth="300">
                    <Label text="ĐƠN HỦY/LỖI" textFill="white" style="-fx-font-weight: bold;"/>
                    <Label text="0" textFill="white" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 15;">
                <Label text="Biểu đồ doanh thu 7 ngày gần nhất" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                <BarChart fx:id="chartRevenue" prefHeight="300" legendVisible="false">
                    <xAxis><CategoryAxis label="Ngày" /></xAxis>
                    <yAxis><NumberAxis label="Doanh thu (VNĐ)" /></yAxis>
                </BarChart>
            </VBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 15;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Chi tiết giao dịch" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <DatePicker fx:id="datePicker" promptText="Lọc theo ngày" />
                    <Button text="Lọc" onAction="#handleFilter" style="-fx-background-color: #6F4E37; -fx-text-fill: white; -fx-cursor: hand;"/>
                </HBox>

                <TableView fx:id="tableOrders" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colId" text="Mã HĐ" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colDate" text="Ngày bán" prefWidth="120" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colTime" text="Giờ bán" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colTotal" text="Tổng tiền" prefWidth="150" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold; -fx-text-fill: green;"/>
                        <TableColumn fx:id="colPayment" text="Thanh toán" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>